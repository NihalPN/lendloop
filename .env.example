# ==============================================================================
# LendLoop Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: All values in this example file are intentionally empty to prevent
# accidental secret leakage. Never commit real secrets or .env.local to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex Backend Configuration
# ------------------------------------------------------------------------------
# Public deployment URL for Convex (e.g. http://127.0.0.1:3210 for local dev, or https://<deployment>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
# Base HTTP site URL for Convex HTTP actions (e.g. http://localhost:3211 or http://host.docker.internal:3211 for Docker)
CONVEX_SITE_URL=
# Initial admin email to seed on first Clerk login (promoted to role: "admin")
ADMIN_SEED_EMAIL=

# ------------------------------------------------------------------------------
# 2. Clerk Authentication Configuration (Core 3)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (pk_test_... or pk_live_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk Secret Key (sk_test_... or sk_live_...)
CLERK_SECRET_KEY=
# Clerk JWT Issuer Domain for Convex OIDC validation (e.g. https://<app>.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=
# Clerk UI routing redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=

# ------------------------------------------------------------------------------
# 3. n8n Automation & HMAC Security (Contracts A, B, C)
# ------------------------------------------------------------------------------
# Outbound webhook URL called by Convex when loan events fire (e.g. http://localhost:5678/webhook/lendloop-loan-events)
N8N_WEBHOOK_URL=
# Shared secret for signing outbound Convex -> n8n loan event webhooks (Contract A)
N8N_WEBHOOK_SECRET=
# Shared secret for verifying inbound n8n -> Convex calls (/overdue-loans, /reminder-result; Contracts B & C)
N8N_API_SECRET=
# Alias used by n8n containers for webhook secret verification
LENDLOOP_WEBHOOK_SECRET=
# Alias used by n8n containers for API request signing
LENDLOOP_API_SECRET=
# Optional n8n basic auth settings for self-hosted instances
N8N_BASIC_AUTH_ACTIVE=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Playwright End-to-End Testing
# ------------------------------------------------------------------------------
# Base URL for the running Next.js application (default: http://localhost:3000)
E2E_BASE_URL=
# Email of the admin test account (matches ADMIN_SEED_EMAIL in dev)
E2E_ADMIN_EMAIL=
# Email of a standard test borrower/lender account
E2E_USER_EMAIL=
# Clerk testing token for programmatic sign-in during E2E specs
CLERK_TESTING_TOKEN=
