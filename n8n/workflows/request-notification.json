        "mode": "runOnceForEachItem",
        "jsCode": "const headers = $('Webhook').item.json.headers;\nconst signatureHex = headers['x-signature'] || headers['X-Signature'];\nconst timestampStr = headers['x-timestamp'] || headers['X-Timestamp'];\nconst body = $('Webhook').item.json.body;\n\nif (!signatureHex || !timestampStr) {\n  throw new Error('Missing authentication headers.');\n}\n\nconst ts = Number(timestampStr);\nconst now = Math.floor(Date.now() / 1000);\n\nif (!Number.isFinite(ts) || Math.abs(now - ts) > 300) {\n  throw new Error('Webhook timestamp expired. Possible replay attack.');\n}\n\nconst method = 'POST';\nconst path = '/webhook/lendloop-loan-events';\nconst rawBody = JSON.stringify(body);\nconst canonical = `${ts}.${method}.${path}.${rawBody}`;\n\nreturn {\n  json: {\n    signatureHex,\n    canonical,\n  },\n};"
      },
