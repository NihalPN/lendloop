        "jsCode": "const loan = $('HTTP Request').item.json;\nconst loanId = loan.loanId ?? loan._id;\n\nif (!loanId) {\n  throw new Error('Missing loanId from HTTP Request node.');\n}\n\nconst todayUtc = new Date().toISOString().slice(0, 10);\nconst payload = {\n  loanId,\n  idempotencyKey: `${loanId}:${todayUtc}`,\n  status: 'sent',\n};\n\nconst rawBody = JSON.stringify(payload);\nconst ts = String(Math.floor(Date.now() / 1000));\nconst method = 'POST';\nconst path = '/reminder-result';\nconst canonical = `${ts}.${method}.${path}.${rawBody}`;\n\nreturn {\n  json: {\n    rawBody,\n    timestamp: ts,\n    canonical,\n  },\n};"
      },
